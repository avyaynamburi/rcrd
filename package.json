{
  "name": "rcrd",
  "version": "0.1.0",
  "description": "",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write app components lib tests scripts/*.ts public/*.js vercel.json *.ts *.mjs components.json package.json tsconfig.json .prettierrc.json .github/workflows/*.yml",
    "format:check": "prettier --check app components lib tests scripts/*.ts public/*.js vercel.json *.ts *.mjs components.json package.json tsconfig.json .prettierrc.json .github/workflows/*.yml",
    "check": "npm run lint && npm run typecheck && npm test && npm run format:check",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:types": "node scripts/database-types.ts",
    "db:test": "supabase test db tests/rls/tenancy.sql tests/rls/accounts.sql",
    "db:seed:preview": "node scripts/demo-seed.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avyaynamburi/rcrd.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/avyaynamburi/rcrd/issues"
  },
  "homepage": "https://github.com/avyaynamburi/rcrd#readme",
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "supabase": "2.122.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "private": true,
  "engines": {
    "node": ">=24 <25"
  }
}
