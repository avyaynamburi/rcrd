# Rcrd environment variables — copy to .env.local and fill in. Never commit real values.

# Supabase (Mumbai region project; local values come from `npx supabase start`)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Encryption key for Aadhaar/ID numbers, bank account numbers and integration credentials (32-byte base64)
FIELD_ENCRYPTION_KEY=

# AI providers (server only) — spec 12
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# JSON routing per task type, e.g. {"chat":"anthropic:<model>","transcribe":"openai:<model>","draft":"gemini:<model>"}
AI_ROUTING=

# Messaging providers — spec 13 (leave empty to use the log-only adapter)
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
SMS_PROVIDER=
SMS_API_KEY=
SMS_DLT_ENTITY_ID=
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

# Payments (later phase)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cron route protection
CRON_SECRET=
